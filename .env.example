# EducaflowOne - modelo de configuracao.
#
# Copie para `.env` e preencha com valores LOCAIS (nunca de producao):
#     cp .env.example .env
#
# O `.env` esta no .gitignore e NAO deve voltar para o repositorio: ele ja
# esteve versionado aqui e expos credenciais reais num repo publico.
#
# Em producao (Railway) nao existe ficheiro .env - tudo vem das variaveis de
# ambiente do servico. Este ficheiro serve de inventario do que precisa estar
# configurado la.
#
# Para desenvolvimento use `dev_local.py` no lugar do `manage.py`: ele desliga
# e-mail e n8n antes do Django carregar as settings, para nada sair da sua
# maquina para o mundo real.

# ── Django ───────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
# Nota: settings.py hoje tem DEBUG = False fixo e ignora esta variavel.
DEBUG=False
# Dominios separados por virgula, com https:// (o Django nao aceita curinga).
CSRF_TRUSTED_ORIGINS=

# ── Banco de dados ───────────────────────────────────────────────────
# Se DATABASE_URL existir, ela tem prioridade sobre os DB_* abaixo.
DATABASE_URL=
DB_NAME=cini_english
DB_USER=postgres
DB_PASS=masterkey
DB_HOST=localhost
DB_PORT=5432

# ── Superusuario criado no arranque ──────────────────────────────────
# `create_master_user` roda a CADA deploy e redefine a senha deste usuario.
# Se MASTER_PASSWORD nao estiver definida, o comando usa um valor padrao
# que esta no codigo-fonte publico - defina sempre.
MASTER_USERNAME=Admin
MASTER_PASSWORD=
MASTER_EMAIL=
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# ── Stripe ───────────────────────────────────────────────────────────
# Use chaves de TESTE (sk_test_...) localmente. Só o Railway tem as de producao.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASIC_MONTHLY=
STRIPE_PRICE_ID_BASIC_SEMESTRAL=
STRIPE_PRICE_ID_BASIC_ANNUAL=
STRIPE_PRICE_ID_PREMIUM_MONTHLY=
STRIPE_PRICE_ID_PREMIUM_SEMESTRAL=
STRIPE_PRICE_ID_PREMIUM_ANNUAL=
STRIPE_PRICE_ID_PLATINUM_MONTHLY=
STRIPE_PRICE_ID_PLATINUM_SEMESTRAL=
STRIPE_PRICE_ID_PLATINUM_ANNUAL=
# Legado, anterior aos tiers:
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_SEMESTRAL=
STRIPE_PRICE_ID_ANNUAL=

# ── E-mail ───────────────────────────────────────────────────────────
# Prioridade: RESEND_API_KEY > SMTP. Sem nenhum dos dois, cai no backend de
# consola (o e-mail e impresso no terminal) - que e o desejado em local.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=contato@educaflowone.com.br
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SUPPORT_EMAIL=
CONTACT_EMAIL=

# ── Armazenamento de anexos (Cloudflare R2) ──────────────────────────
# Sem R2, os ficheiros vao para o disco do container - que e efemero no
# Railway. Em producao isto deve estar ligado.
USE_R2_STORAGE=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# ── Google Sign-In ───────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
# Alternativa ao anterior: caminho para o JSON do Google Cloud. So e lido se
# GOOGLE_OAUTH_CLIENT_ID estiver vazia. Os JSON em docs/google/ sao ignorados
# pelo git.
ID_JSON_GOOGLE_CLOUD=

# ── n8n (automacoes de onboarding) ───────────────────────────────────
N8N_ONBOARDING_WEBHOOK_ENABLED=false
N8N_ONBOARDING_WEBHOOK_URL=
N8N_ONBOARDING_STATUS_TOKEN=

# ── WhatsApp Business (Cloud API) ────────────────────────────────────
# Interruptor geral. Desligado, nada e enviado e o webhook responde 200 sem
# processar - que e o estado correto ate o piloto ser liberado.
WHATSAPP_ENABLED=false
# Segredo da app da Meta (App Dashboard > Configuracoes > Basico). Usado para
# conferir a assinatura X-Hub-Signature-256 de cada webhook. Sem ele o
# webhook devolve 500 de proposito, para nao aceitar evento nao verificado.
WHATSAPP_APP_SECRET=
# Cadeia inventada por nos, digitada tambem no painel da Meta ao cadastrar a
# URL do webhook. So e usada no handshake inicial.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Chave Fernet (base64 de 32 bytes) para cifrar os tokens de acesso guardados
# no banco. Vazia, a chave e derivada da SECRET_KEY: trocar a SECRET_KEY passa
# a obrigar reconectar as contas.
WHATSAPP_ENCRYPTION_KEY=
# Versao da Graph API. Fixada de proposito: subir versao e um passo
# deliberado, testado, nunca efeito colateral de deploy.
WHATSAPP_GRAPH_VERSION=v23.0
# --- Conexao do numero (Embedded Signup) ---
# ID da app da Meta e ID da configuracao de Embedded Signup. Nenhum dos dois e
# segredo: vao para o browser, porque o popup da Meta precisa deles.
WHATSAPP_APP_ID=
WHATSAPP_CONFIG_ID=
# Variante do Embedded Signup. E este valor que oferece a coexistencia ao
# professor (numero na API e no aplicativo do celular ao mesmo tempo). Deixar
# vazio se a Meta mover esta escolha para dentro da propria configuracao.
WHATSAPP_ES_FEATURE_TYPE=whatsapp_business_app_onboarding

# ── Outros ───────────────────────────────────────────────────────────
SITE_URL=https://www.educaflowone.com.br
